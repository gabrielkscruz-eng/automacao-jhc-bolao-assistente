    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Define um nome padrão caso venha vazio para evitar erro na API\nconst nomeCliente = input.nome || \"Cliente Bolao\";\n\n// Gera e-mail sem espaços e minúsculo\nconst emailLimpo = input.id_interno.replace(/\\s+/g, \"\").toLowerCase() + \"@jhcbolao.kevin.app.br\";\n\nconst payment = {\n  transaction_amount: Number(input.total_geral),\n  description: \"Cota Bolão\",\n  payment_method_id: \"pix\",\n  external_reference: input.id_interno,\n  notification_url: input.notification_url,\n  date_of_expiration: String(input.date_of_expiration), \n  payer: {\n    email: emailLimpo,\n    first_name: nomeCliente\n  }\n};\n\nreturn [{ json: payment }];\n"
      },
