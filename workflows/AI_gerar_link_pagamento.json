    {
      "parameters": {
        "jsCode": "/***********************\n * 🔧 CONFIGURAÇÃO E ENTRADA\n ***********************/\nconst BASE_URL = \"https://jhcbolao.kevin.app.br\";\nconst entrada = $input.first().json;\nconst dados = Array.isArray(entrada) ? entrada : entrada; // Garante captura correta\nconst jogos = dados.jogos;\n\nif (!Array.isArray(jogos)) {\n  throw new Error(\"O campo 'jogos' precisa ser um array.\");\n}\n\nlet total = 0;\n\n/***********************\n * 📊 CÁLCULO E DETALHAMENTO\n ***********************/\nconst detalhamento = jogos.map(jogo => {\n  const preco = Number(jogo.valor_unitario) || 0;\n  const quantidade = Number(jogo.quantidade_cotas) || 0;\n  const subtotal = preco * quantidade;\n  total += subtotal;\n\n  return {\n    nome_jogo: jogo.nome_jogo,\n    preco_unitario: preco,\n    quantidade_cotas: quantidade,\n    subtotal: subtotal,\n    link_tabela: jogo.link_tabela\n  };\n});\n\nconst id_interno = \"pedido_\" + Date.now() + \"_\" + Math.floor(Math.random() * 1000);\n\n/***********************\n * ⏳ LÓGICA DE EXPIRAÇÃO (18H BRASÍLIA)\n ***********************/\n// 1. Pega o horário atual forçando o fuso de São Paulo (mesmo com n8n em NY)\nconst agoraBR = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"America/Sao_Paulo\"}));\n\n// 2. Define a expiração base para HOJE às 18:00\nlet dataExpiracao = new Date(agoraBR);\ndataExpiracao.setHours(18, 0, 0, 0);\n\n// 3. Se agora já passou das 18h, pula o vencimento para amanhã às 18h\nif (agoraBR >= dataExpiracao) {\n  dataExpiracao.setDate(dataExpiracao.getDate() + 1);\n}\n\n// 4. Formata a string ISO final com o sufixo -03:00 fixo\nconst pad = (n) => String(n).padStart(2, '0');\nconst ano = dataExpiracao.getFullYear();\nconst mes = pad(dataExpiracao.getMonth() + 1);\nconst dia = pad(dataExpiracao.getDate());\n\n// Resultado final: YYYY-MM-DDT18:00:00.000-03:00\nconst expirationISO = `${ano}-${mes}-${dia}T18:00:00.000-03:00`;\n\n/***********************\n * 🚀 RETORNO\n ***********************/\nreturn [\n  {\n    json: {\n      id_interno,\n      total_geral: Number(total.toFixed(2)),\n      detalhamento,\n      nome: dados.nome || \"Cliente\",\n      numero: dados.numero,\n      date_of_expiration: expirationISO,\n      notification_url: `${BASE_URL}/webhook/pagamento_bolao`\n    }\n  }\n];\n"
      },
